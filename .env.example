DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=4173
# Comma-separated frontend origins, without paths. Empty allows only same-origin.
ALLOWED_ORIGINS=
# Keep a long random value here on a production server.
RATE_LIMIT_SALT=
# Local server only: trust X-Forwarded-For only behind your own trusted proxy.
TRUST_PROXY=false
